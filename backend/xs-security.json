{
  "xsappname": "oilAndGas_Tracking",
  "tenant-mode": "dedicated",
  "description": "Security profile for Oil and Gas Tracking",
  "scopes": [
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Admin access"
    }
  ],
  "authorities": [
    "$XSAPPNAME.Admin"
  ],
  "role-templates": [
    {
      "name": "AdminRole",
      "description": "Administrator Role",
      "scope-references": [
        "$XSAPPNAME.Admin"
      ]
    }
  ],
   "oauth2-configuration": {
    "redirect-uris": [
      "httpus10-001.hana.ondemand.coms://*./**",
      "https://*.us10.hana.ondemand.com/**"
    ]
  }
}