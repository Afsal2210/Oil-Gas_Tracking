<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog title="{i18n>createStockInTitle}" contentWidth="26rem">
    <content>
      <VBox class="sapUiSmallMargin">
        <Label text="{i18n>colProduct}" required="true"/>
        <Select items="{/Products}" selectedKey="{newStockIn>productId}" width="100%">
          <core:Item key="{ID}" text="{name}"/>
        </Select>
        <Label text="{i18n>colQuantity}" required="true"/>
        <Input type="Number" value="{newStockIn>quantity}"/>
        <Label text="{i18n>colUnitPrice}"/>
        <Input type="Number" value="{newStockIn>unitPrice}"/>
        <Label text="{i18n>colSupplier}"/>
        <Input value="{newStockIn>supplier}"/>
        <Label text="{i18n>colDate}"/>
        <DatePicker value="{newStockIn>receivedDate}" valueFormat="yyyy-MM-dd" displayFormat="medium"/>
        <Label text="{i18n>colRemarks}"/>
        <TextArea value="{newStockIn>remarks}" width="100%" rows="2"/>
      </VBox>
    </content>
    <beginButton>
      <Button text="{i18n>create}" type="Emphasized" press=".onConfirmStockIn"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press=".onCancelDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
