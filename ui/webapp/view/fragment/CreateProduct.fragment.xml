<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog title="{i18n>createProductTitle}" contentWidth="26rem">
    <content>
      <VBox class="sapUiSmallMargin">
        <Label text="{i18n>colName}" required="true"/>
        <Input value="{newProduct>name}"/>
        <Label text="{i18n>colType}" required="true"/>
        <Input value="{newProduct>type}"/>
        <Label text="{i18n>colUnit}"/>
        <Input value="{newProduct>unit}"/>
        <Label text="{i18n>colDescription}"/>
        <TextArea value="{newProduct>description}" width="100%" rows="2"/>
      </VBox>
    </content>
    <beginButton>
      <Button text="{i18n>create}" type="Emphasized" press=".onConfirmProduct"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press=".onCancelDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
