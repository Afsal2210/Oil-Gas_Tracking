<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog title="{i18n>createSaleTitle}" contentWidth="26rem">
    <content>
      <VBox class="sapUiSmallMargin">
        <Label text="{i18n>colProduct}" required="true"/>
        <Select items="{/Products}" selectedKey="{newSale>productId}" width="100%">
          <core:Item key="{ID}" text="{name}"/>
        </Select>
        <Label text="{i18n>colQuantity}" required="true"/>
        <Input type="Number" value="{newSale>quantity}"/>
        <Label text="{i18n>colUnitPrice}"/>
        <Input type="Number" value="{newSale>unitPrice}"/>
        <Label text="{i18n>colCustomer}"/>
        <Input value="{newSale>customer}"/>
        <Label text="{i18n>colDate}"/>
        <DatePicker value="{newSale>soldDate}" valueFormat="yyyy-MM-dd" displayFormat="medium"/>
        <Label text="{i18n>colRemarks}"/>
        <TextArea value="{newSale>remarks}" width="100%" rows="2"/>
      </VBox>
    </content>
    <beginButton>
      <Button text="{i18n>create}" type="Emphasized" press=".onConfirmSale"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press=".onCancelDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
