<mvc:View
  controllerName="oilandgas.ui.controller.App"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <App>
    <Page title="{i18n>appTitle}" showHeader="true">
      <Table
        id="productsTable"
        items="{ path: '/Products', parameters: { $orderby: 'name asc' } }"
        growing="true"
        growingThreshold="20"
        noDataText="{i18n>noProductsData}">
        <headerToolbar>
          <Toolbar>
            <Title text="{i18n>productsTab}" level="H2"/>
            <ToolbarSpacer/>
            <!-- <Button text="{i18n>create}" type="Emphasized" icon="sap-icon://add" press=".onCreateProduct"/> -->
          </Toolbar>
        </headerToolbar>
        <columns>
          <Column><Text text="{i18n>colName}"/></Column>
          <Column><Text text="{i18n>colType}"/></Column>
          <Column><Text text="{i18n>colUnit}"/></Column>
          <Column><Text text="{i18n>colDescription}"/></Column>
          <Column><Text text="{i18n>colPrice}"/></Column>
          <Column><Text text="{i18n>colStockQuantity}"/></Column>
          <Column><Text text="{i18n>colSupplier}"/></Column>
          <Column><Text text="{i18n>colStorageLocation}"/></Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <Text text="{name}"/>
              <Text text="{type}"/>
              <Text text="{unit}"/>
              <Text text="{description}"/>
              <Text text="{price}"/>
              <Text text="{stockQuantity}"/>
              <Text text="{supplier}"/>
              <Text text="{storageLocation}"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </Page>
  </App>
</mvc:View>
